# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — NEVER commit real secrets. Ignore all local env files…
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local
# …but DO track the safe placeholder templates so collaborators know the shape.
!.env.example
!.env.local.example

# local agent tooling (AI assistant skills/agents/hooks — not part of the app)
.agents/
.claude/
.codex/
.cursor/
.gemini/
.impeccable/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
